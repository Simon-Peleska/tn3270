# libFuzzer dictionary for npm run fuzz: 3270 write commands, orders, and the attribute types
# that Set Attribute, Start Field Extended and Modify Field take. Values are left to the fuzzer.
write="\xf1"
erase_write="\xf5"
erase_write_alternate="\x7e"
erase_all_unprotected="\x6f"
write_structured_field="\xf3"
read_buffer="\xf2"
read_modified="\xf6"
read_modified_all="\x6e"
sba="\x11"
sf="\x1d"
sfe="\x29"
sa="\x28"
mf="\x2c"
ic="\x13"
pt="\x05"
ra="\x3c"
eua="\x12"
ge="\x08"
type_reset="\x00"
type_3270="\xc0"
type_validation="\xc1"
type_outlining="\xc2"
type_highlighting="\x41"
type_foreground="\x42"
type_charset="\x43"
type_background="\x45"
type_transparency="\x46"
type_input_control="\xfe"
sa_highlighting="\x28\x41"
sa_foreground="\x28\x42"
sa_background="\x28\x45"
sa_charset="\x28\x43"
sa_reset="\x28\x00\x00"
