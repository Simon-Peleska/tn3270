{
  "server": {
    "host": "127.0.0.1",
    "port": 8017,
  },

  // One b3270 process per session.
  "b3270": {
    // A bare name is resolved from PATH.
    "path": "b3270",

    // 2 = 24x80, 3 = 32x80, 4 = 43x80, 5 = 27x132.
    "model": 2,

    // Used when a session is created without one; null starts disconnected.
    "defaultHost": "http://localhost:8017",

    // Any b3270 resource, passed as -xrm. A bare name is qualified "b3270.<name>";
    // write "b3270.x" or "*x" in full for a different qualifier.
    // https://x3270.miraheze.org/wiki/Category:Resources
    "settings": {
      // "codePage": "german",

      // Columns x rows, at least the model's own size; negotiates IBM-DYNAMIC.
      // Only a starting point: "Fit to window" changes it per session.
      "oversize": "160x62",

      // "monoCase": true,
      // "typeahead": false,
      // "verifyHostCert": true,
      // "nopSeconds": 60
    },

    // Appended verbatim, for options that are not resources: ["-cafile", "/path/to/ca.pem"]
    "extraArgs": [],
  },

  "sessions": {
    "maxSessions": 16,
    "maxViewersPerSession": 8,

    // How long a session survives with no viewer, so a reload keeps the host session.
    "idleTimeoutMs": 300000,
  },

  "security": {
    // An entry without a port allows any port on that host; an empty list allows any host.
    "allowedHosts": [],

    // Take the client address and name from "X-Forwarded-For" / "X-Remote-User".
    // Only with a reverse proxy in front: otherwise anyone can forge both.
    "trustProxyHeaders": false,
  },

  // "debug" logs every line exchanged with b3270. Very noisy.
  "logLevel": "info",

  // Logged to stderr as well. Rolls over to "<logFile>.1" past logMaxBytes; "" is stderr only.
  "logFile": "log/tn3270.log",
  "logMaxBytes": 10485760,
}
