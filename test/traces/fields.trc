// rows 43
// columns 80
//
// A plain screen with ordinary, visible input fields, for driving the emulator
// by hand: `npm run start:fake`. The x3270 traces next to this one all put a
// non-display field under the cursor, so typing into them shows nothing.
//
// The TELNET negotiation below is the same exchange as reverse.trc; only the
// screen that follows it is ours.
//
// # Ask for TN3270E.
// telnet.do tn3270e
< 0x0   fffd28
// # Ask for the device type.
// telnet.sb tn3270e
//  raw 0802 # send device-type
//  telnet.se
< 0x0   fffa280802fff0
// # Tell them what the device type is.
// telnet.sb tn3270e
//  raw 0204 # device-type is
//  atext IBM-3278-4-E
//  raw 01 # connect
//  atext IBM0TEQO
//  telnet.se
< 0x0   fffa28020449424d2d333237382d342d450149424d305445514ffff0
// # Tell them what TN3270E we will support (no BIND-IMAGE)
// telnet.sb tn3270e
//  raw 0304 # functions is
//  raw 0204 #  RESPONSES SYSREQ
//  telnet.se
< 0x0   fffa2803040204fff0
// # Draw the screen.
// tn3270e 3270-data none no-response 0
//  cmd.ewa restore,reset-mdt
//   ord.sba 1 1
//   ord.sf protect,skip,intensify
//   text "TN3270 TEST SCREEN"
//   ord.sba 3 1
//   ord.sf protect,skip
//   text "Name:"
//   ord.sba 3 11
//   ord.sfe normal,underscore     # 20 columns, ends at the field below
//   ord.sba 3 32
//   ord.sf protect,skip
//   ord.sba 5 1
//   ord.sf protect,skip
//   text "Note:"
//   ord.sba 5 11
//   ord.sfe intensify,underscore  # 40 columns
//   ord.sba 5 52
//   ord.sf protect,skip
//   ord.sba 7 1
//   ord.sf protect,skip
//   text "Secret:"
//   ord.sba 7 11
//   ord.sfe zero,underscore       # non-display, so the hidden case stays testable
//   ord.sba 7 32
//   ord.sf protect,skip
//   ord.sba 9 1
//   ord.sf protect,skip
//   text "Type into the fields above. Tab moves, Enter locks the"
//   ord.sba 10 1
//   ord.sf protect,skip
//   text "keyboard: the replay has no host to answer it. Reset clears."
//   ord.sba 12 1
//   ord.sf protect,skip
//   text "Box drawing, and ligatures in a font that has them, like JetBrains Mono:"
//   ord.sba 14 1
//   ord.sf protect,skip
//   text "=> -> <- <= >= == === /= <> <=> --> <-- :: && ... >>= =<<"
//   ord.sba 16 1
//   ord.sf protect,skip
//   text "┌────────────┬────────────┐"
//   ord.sba 17 1
//   ord.sf protect,skip
//   text "│ arrow  =>  │ not   /=   │"
//   ord.sba 18 1
//   ord.sf protect,skip
//   text "├────────────┼────────────┤"
//   ord.sba 19 1
//   ord.sf protect,skip
//   text "│ left   <-  │ same  ==   │"
//   ord.sba 20 1
//   ord.sf protect,skip
//   text "└────────────┴────────────┘"
//   ord.sba 22 1
//   ord.sf protect,skip
//   text "Data set names, opened in VS Code with Shift+click when its repo has them:"
//   ord.sba 24 1
//   ord.sf protect,skip
//   text "  USER.PLI.SOURCE(PGM1)      in the repo, no file extension"
//   ord.sba 25 1
//   ord.sf protect,skip
//   text "  'USER.PLI.SOURCE(PGM2)'    in the repo as PGM2.pli, quoted"
//   ord.sba 26 1
//   ord.sf protect,skip
//   text "  USER.PLI.SOURCE(NOTHERE)   not in the repo"
//   ord.sba 27 1
//   ord.sf protect,skip
//   text "  USER.PLI.DATA              sequential, not in the repo"
//   ord.sba 3 12
//   ord.ic
//  telnet.eor
