// Manual testing against the replayed host: npm run start:fake
//
// The traces were recorded against a model 4, and without "oversize": that
// would negotiate IBM-DYNAMIC and let the host pick a size the recording lacks.
{
  "server": {
    "host": "127.0.0.1",
    "port": 8017,
  },

  "b3270": {
    "path": "b3270",
    "model": 4,
    "defaultHost": "127.0.0.1:4001",
  },

  "logLevel": "info",
}
