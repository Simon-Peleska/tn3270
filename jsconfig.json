{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["server/**/*.js", "public/**/*.js", "test/**/*.js"],
  "exclude": ["node_modules"]
}
